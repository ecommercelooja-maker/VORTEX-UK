# Public URL of the site (no trailing slash). Used for canonical links, Open Graph,
# robots.txt, sitemap.xml and the policy pages. Set it in Vercel > Settings > Environment
# Variables (Production) when the custom domain is connected.
NEXT_PUBLIC_SITE_URL=https://vortexemobility.com

# --- Identidade da loja (usada para separar as 3 lojas no mesmo Supabase e no dashboard central)
STORE_ID=vortex_uk
STORE_NAME=VORTEX UK
STORE_LOCALE=en-GB
STORE_CURRENCY=GBP
DEFAULT_PHONE_COUNTRY=GB

# --- Supabase (projeto único compartilhado pelas 3 lojas) — SOMENTE servidor
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Dashboard /admin
ADMIN_PASSWORD=
# gere com: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# --- Webhook do Umpi: cadastre no painel do Umpi a URL
#     https://vortexemobility.com/api/webhooks/umpi?token=<WEBHOOK_SECRET>
WEBHOOK_SECRET=
# Umpi envia valores em centavos? (true = 8490 -> 84,90)
CHECKOUT_AMOUNTS_IN_CENTS=true

# --- Cron (Vercel envia Authorization: Bearer <CRON_SECRET> automaticamente)
CRON_SECRET=

# --- E-mail transacional (Resend). Sem isso, automações de e-mail ficam "failed" com o motivo no dashboard.
RESEND_API_KEY=
EMAIL_FROM="VORTEX UK <no-reply@vortexemobility.com>"
EMAIL_REPLY_TO=

# --- WhatsApp: Meta WhatsApp Cloud API (ver src/lib/crm/providers/whatsapp.ts).
#     Sem WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID nenhuma automação de WhatsApp é criada.
#     Toda mensagem iniciada pela loja precisa de um TEMPLATE aprovado na Meta (nomes abaixo); texto livre só na janela de 24 h.
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER=
# Meta Business → WhatsApp → API Setup → "Phone number ID"
WHATSAPP_PHONE_NUMBER_ID=
# token permanente (usuário do sistema com permissão whatsapp_business_messaging)
WHATSAPP_ACCESS_TOKEN=
# nomes dos templates aprovados na Meta. Variáveis: carrinho {{1}} nome {{2}} resumo da compra {{3}} link;
# compra {{1}} nome {{2}} nº pedido {{3}} total {{4}} link do pedido; rastreio {{1}} nome {{2}} nº pedido {{3}} código {{4}} link
WHATSAPP_TEMPLATE_ABANDONED_CART=
WHATSAPP_TEMPLATE_PURCHASE=
WHATSAPP_TEMPLATE_TRACKING=
# idiomas em que os templates foram criados na Meta (fr, pt, en, de); cliente de outro idioma recebe o primeiro
WHATSAPP_TEMPLATE_LANGS=en

# --- Assistente de I.A. do dashboard (/admin/assistente): chave da Anthropic (console.anthropic.com → API keys).
#     Sem a chave, a aba mostra um aviso e nada mais muda. Modelo opcional (padrão: claude-opus-5).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Regras (fallback; editáveis em /admin/configuracoes)
ABANDONED_CART_TIMEOUT_MINUTES=30
AUTOMATION_DEDUPE_HOURS=24
CART_EXPIRE_DAYS=30
PROMOTION_ACTIVE=false
PROMOTION_START_AT=
PROMOTION_END_AT=
PROMOTION_MESSAGE=
